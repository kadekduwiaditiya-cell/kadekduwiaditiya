# Cloudflare Worker secrets
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FIRESTORE_URL=https://firestore.googleapis.com/v1/projects/YOUR_PROJECT_ID/databases/(default)/documents/users/YOUR_USER_ID/transactions
DEFAULT_USER_ID=YOUR_USER_ID
# Untuk produksi, ganti FIRESTORE write dengan credential OAuth/service account di Worker secrets.
# Jangan commit token bot atau private key ke repo.